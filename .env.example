# ========================================================
# SecureDoc AI — Environment Configuration Template
# ========================================================

# 1. Google Gemini API (Required for Cloud LLM Analysis)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local Ollama Service (Optional - Hybrid Router for On-Premise)
# Chạy mô hình nội bộ Qwen: ollama run qwen2.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# 3. Enterprise Database Persistence (SQLAlchemy 2.0 Async)
# Mặc định tự động fallback sang SQLite: sqlite+aiosqlite:///data/securedoc.db
# Đối với môi trường Production / PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securedoc_ai

# 4. Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
